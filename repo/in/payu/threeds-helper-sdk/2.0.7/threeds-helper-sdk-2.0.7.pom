<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <groupId>in.payu</groupId>
  <artifactId>threeds-helper-sdk</artifactId>
  <version>2.0.7</version>
  <packaging>aar</packaging>
  <name>threeds-helper-sdk</name>
  <description>3DS SDK for PayU Android.</description>
  <url>https://github.com/payu-intrepos/payu-3ds-sdk</url>
  <licenses>
    <license>
      <name>The MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>mobile_payu</id>
      <name>PayU Mobile</name>
      <email>payumoneyapp@payumoney.com</email>
    </developer>
  </developers>
  <scm>
    <url>https://github.com/payu-intrepos/payu-3ds-sdk</url>
  </scm>
  <dependencies>
    <dependency>
      <artifactId>appcompat</artifactId>
      <groupId>androidx.appcompat</groupId>
      <version>1.3.0</version>
      <scope></scope>
    </dependency>
    <dependency>
      <artifactId>rxandroid</artifactId>
      <groupId>io.reactivex</groupId>
      <version>1.2.1</version>
      <scope></scope>
    </dependency>
    <dependency>
      <artifactId>nimbus-jose-jwt</artifactId>
      <groupId>com.nimbusds</groupId>
      <version>10.0.2</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <artifactId>jose4j</artifactId>
      <groupId>org.bitbucket.b_c</groupId>
      <version>0.6.5</version>
      <scope></scope>
    </dependency>
    <dependency>
      <artifactId>bcprov-jdk15to18</artifactId>
      <groupId>org.bouncycastle</groupId>
      <version>1.84</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <artifactId>gson</artifactId>
      <groupId>com.google.code.gson</groupId>
      <version>2.8.0</version>
      <scope></scope>
    </dependency>
    <dependency>
      <artifactId>okhttp</artifactId>
      <groupId>com.squareup.okhttp3</groupId>
      <version>4.12.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <artifactId>logging-interceptor</artifactId>
      <groupId>com.squareup.okhttp3</groupId>
      <version>4.12.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <artifactId>rootbeer-lib</artifactId>
      <groupId>com.scottyab</groupId>
      <version>0.1.1</version>
      <scope></scope>
    </dependency>
    <dependency>
      <artifactId>payu-crash-logger</artifactId>
      <groupId>in.payu</groupId>
      <version>[1.1.1,1.2.0)</version>
      <scope></scope>
    </dependency>
    <dependency>
      <artifactId>native-otp-reader</artifactId>
      <groupId>in.payu</groupId>
      <version>1.3.2</version>
      <scope></scope>
    </dependency>
    <dependency>
      <artifactId>material</artifactId>
      <groupId>com.google.android.material</groupId>
      <version>1.0.0</version>
      <scope></scope>
    </dependency>
    <dependency>
      <artifactId>payuanalytics</artifactId>
      <groupId>in.payu</groupId>
      <version>1.5.3</version>
      <scope></scope>
    </dependency>
  </dependencies>
</project>
