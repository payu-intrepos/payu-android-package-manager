<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <groupId>in.payu</groupId>
  <artifactId>threeds-helper-sdk</artifactId>
  <version>2.0.0-alpha7</version>
  <packaging>aar</packaging>
  <name>threeds-helper-sdk</name>
  <description>3DS2 SDK for PayU Android. EMV 3-D Secure Protocol implementation.</description>
  <url>https://github.com/payu-intrepos/payu-3ds-sdk</url>
  <licenses>
    <license>
      <name>Proprietary</name>
      <url>https://github.com/payu-intrepos/payu-3ds-sdk</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>payu</id>
      <name>PayU</name>
      <url>https://github.com/payu-intrepos/payu-3ds-sdk</url>
    </developer>
  </developers>
  <scm>
    <url>https://github.com/payu-intrepos/payu-3ds-sdk</url>
  </scm>
  <dependencies>
    <dependency>
      <groupId>androidx.appcompat</groupId>
      <artifactId>appcompat</artifactId>
      <version>1.3.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>io.reactivex</groupId>
      <artifactId>rxandroid</artifactId>
      <version>1.2.1</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.nimbusds</groupId>
      <artifactId>nimbus-jose-jwt</artifactId>
      <version>10.0.2</version>
      <scope>compile</scope>
      <exclusions>
        <exclusion>
          <groupId>com.google.crypto.tink</groupId>
          <artifactId>tink</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.bouncycastle</groupId>
          <artifactId>bcprov-jdk18on</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.bouncycastle</groupId>
          <artifactId>bcutil-jdk18on</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.bouncycastle</groupId>
          <artifactId>bcpkix-jdk18on</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk15to18</artifactId>
      <version>1.84</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.bitbucket.b_c</groupId>
      <artifactId>jose4j</artifactId>
      <version>0.6.5</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.10.1</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>okhttp</artifactId>
      <version>4.12.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>logging-interceptor</artifactId>
      <version>4.12.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.scottyab</groupId>
      <artifactId>rootbeer-lib</artifactId>
      <version>0.0.1</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>in.payu</groupId>
      <artifactId>payu-crash-logger</artifactId>
      <version>1.1.1</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>in.payu</groupId>
      <artifactId>native-otp-reader</artifactId>
      <version>1.3.2</version>
      <scope>compile</scope>
      <exclusions>
        <exclusion>
          <groupId>in.payu</groupId>
          <artifactId>payuanalytics</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.google.android.material</groupId>
      <artifactId>material</artifactId>
      <version>1.0.0</version>
      <scope>compile</scope>
      <exclusions>
        <exclusion>
          <groupId>androidx.annotation</groupId>
          <artifactId>annotation</artifactId>
        </exclusion>
        <exclusion>
          <groupId>androidx.drawerlayout</groupId>
          <artifactId>drawerlayout</artifactId>
        </exclusion>
        <exclusion>
          <groupId>androidx.dynamicanimation</groupId>
          <artifactId>dynamicanimation</artifactId>
        </exclusion>
        <exclusion>
          <groupId>androidx.annotation</groupId>
          <artifactId>annotation-experimental</artifactId>
        </exclusion>
        <exclusion>
          <groupId>androidx.transition</groupId>
          <artifactId>transition</artifactId>
        </exclusion>
        <exclusion>
          <groupId>androidx.viewpager2</groupId>
          <artifactId>viewpager2</artifactId>
        </exclusion>
        <exclusion>
          <groupId>androidx.core</groupId>
          <artifactId>core</artifactId>
        </exclusion>
        <exclusion>
          <groupId>androidx.legacy</groupId>
          <artifactId>legacy-support-core-utils</artifactId>
        </exclusion>
        <exclusion>
          <groupId>androidx.fragment</groupId>
          <artifactId>fragment</artifactId>
        </exclusion>
        <exclusion>
          <groupId>androidx.appcompat</groupId>
          <artifactId>appcompat</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>in.payu</groupId>
      <artifactId>payuanalytics</artifactId>
      <version>1.5.3</version>
      <scope>compile</scope>
      <exclusions>
        <exclusion>
          <groupId>com.squareup.okhttp3</groupId>
          <artifactId>okhttp</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>
</project>
