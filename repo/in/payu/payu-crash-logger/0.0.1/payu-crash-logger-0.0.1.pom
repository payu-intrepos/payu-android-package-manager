    </license>
  </licenses>
  <developers>
    <developer>
      <id>mobile_payu</id>
      <name>PayU Mobile</name>
      <email>payumoneyapp@payumoney.com</email>
    </developer>
    <developer>
      <id>payu</id>
      <name>PayU payments</name>
      <url>https://github.com/payu-intrepos/payu-crash-reporter</url>
    </developer>
  </developers>
  <scm>
    <url>https://github.com/payu-intrepos/payu-crash-reporter</url>
  </scm>
  <dependencies>
    <dependency>
      <artifactId>kotlin-stdlib-jdk7</artifactId>
      <groupId>org.jetbrains.kotlin</groupId>
      <version>1.4.31</version>
