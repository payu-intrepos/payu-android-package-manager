      <name>PayU payments</name>
      <url>https://github.com/payu-intrepos/PayUCheckoutPro-Android</url>
    </developer>
  </developers>
  <scm>
    <url>https://github.com/payu-intrepos/PayUCheckoutPro-Android</url>
  </scm>
  <dependencies>
    <dependency>
      <groupId>in.payu</groupId>
      <artifactId>payu-custom-browser</artifactId>
      <version>7.16.3</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>in.payu</groupId>
      <artifactId>payu-checkout-pro-ui</artifactId>
