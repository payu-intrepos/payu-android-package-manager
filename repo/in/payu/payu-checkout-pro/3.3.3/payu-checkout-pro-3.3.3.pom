  <!-- do_not_remove: published-with-gradle-metadata -->
  <modelVersion>4.0.0</modelVersion>
  <groupId>in.payu</groupId>
  <artifactId>payu-checkout-pro</artifactId>
  <version>3.3.3</version>
  <packaging>aar</packaging>
  <name>com.payu.checkoutpro</name>
  <description>PayU CheckoutPro SDK For Android</description>
  <url>https://github.com/payu-intrepos/PayUCheckoutPro-Android</url>
  <licenses>
    <license>
      <name>The MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>
  <developers>
