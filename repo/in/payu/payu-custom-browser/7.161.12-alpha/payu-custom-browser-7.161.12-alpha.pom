<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <groupId>in.payu</groupId>
  <artifactId>payu-custom-browser</artifactId>
  <version>7.161.12-alpha</version>
  <packaging>aar</packaging>
  <name>com.payu.custombrowser</name>
  <description>Native bank page support for Android devices.</description>
  <url>https://github.com/payu-intrepos/Android-Custom-Browser</url>
  <licenses>
    <license>
      <name>The MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
    <license>
      <name>The MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>mobile_payu</id>
      <name>PayU Mobile</name>
      <email>payumoneyapp@payumoney.com</email>
    </developer>
    <developer>
      <id>payu</id>
      <name>PayU payments</name>
      <url>https://github.com/payu-intrepos/Android-Custom-Browser</url>
    </developer>
  </developers>
  <scm>
    <url>https://github.com/payu-intrepos/Android-Custom-Browser</url>
  </scm>
  <dependencies>
    <dependency>
      <artifactId>appcompat</artifactId>
      <groupId>androidx.appcompat</groupId>
      <version>1.6.1</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <artifactId>localbroadcastmanager</artifactId>
      <groupId>androidx.localbroadcastmanager</groupId>
      <version>1.0.0</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <artifactId>recyclerview</artifactId>
      <groupId>androidx.recyclerview</groupId>
      <version>1.2.1</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <artifactId>coordinatorlayout</artifactId>
      <groupId>androidx.coordinatorlayout</groupId>
      <version>1.1.0</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <artifactId>material</artifactId>
      <groupId>com.google.android.material</groupId>
      <version>1.4.0</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <artifactId>play-services-auth-api-phone</artifactId>
      <groupId>com.google.android.gms</groupId>
      <version>17.5.1</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <artifactId>common-ui-sdk</artifactId>
      <groupId>in.payu</groupId>
      <version>1.2.1</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <artifactId>payuanalytics</artifactId>
      <groupId>in.payu</groupId>
      <version>1.6.0</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <artifactId>native-otp-reader</artifactId>
      <groupId>in.payu</groupId>
      <version>1.4.0</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <artifactId>payu-crash-logger</artifactId>
      <groupId>in.payu</groupId>
      <version>[1.1.1,1.2.0)</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>
</project>
